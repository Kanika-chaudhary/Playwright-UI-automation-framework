    "allure:report": "npm run allure:generate && npm run allure:open",
    "allure:clean": "rm -rf allure-results allure-report",
    "test:ui": "npx playwright test --project=ui",
    "test:api": "npx playwright test --project=api",
    "env:dev": "cross-env ENV=dev playwright test",
    "env:qa": "cross-env ENV=qa playwright test",
    "env:stage": "cross-env ENV=stage playwright test tests/cartpagewithfixture.spec.ts"
    

    
   
   
